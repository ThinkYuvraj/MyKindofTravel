rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access
    match /{document=**} {
      allow read: if true;
    }
    
    // WARNING: Since Firebase Auth is not being used to store credentials,
    // we must allow public write access to the CMS document so the client
    // can save changes after passing the local environment variable check.
    match /content/homepage {
      allow write: if true;
    }
  }
}
